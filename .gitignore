# ----------------------------------
# Stock_trade - .gitignore
# ----------------------------------

# Secrets - NEVER committed (Alpaca paper API keys)
.env

# Broker kill switch (local operational state)
HALT

# Database files
trading.db
*.db
*.db-wal
*.db-shm

# Python virtual environment (machine-specific, large, regenerable)
.venv/
venv/

# Local planning / notes (private - stays on your machine, not GitHub)
PROJECT_PLAN.md

# Test / cache artifacts
__pycache__/
*.pyc
.pytest_cache/

# Generated model artifacts
walk_forward_oof*.csv
backtest_*.csv

# Personal testing arena (old-vs-new model faceoff) - never pushed
faceoff/

# Daily run logs
logs/

# Python bytecode cache
__pycache__/
*.pyc

# VS Code workspace settings
.vscode/

# U6 point-in-time membership cache (7MB, regenerable)
sp500_membership.csv
