# Copy this file to .env and paste your Alpaca PAPER keys (never live keys).
# Get them at: alpaca.markets -> dashboard -> switch to Paper trading -> API keys.
# Paper keys start with "PK" - the broker module refuses anything else.
APCA_API_KEY_ID=PK...your-paper-key-id...
APCA_API_SECRET_KEY=...your-paper-secret...
APCA_PAPER=true
